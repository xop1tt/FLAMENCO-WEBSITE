# Локально: cp .env.example .env.local (читается `npm run dev`).
# Для docker compose: cp .env.example .env — оттуда compose берёт
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME как build arg; API_BASE_URL в контейнере
# задаёт сам compose.yaml (http://api:8000).

# Базовый URL backend API (flamenco-studio-bot/src/flamenco_bot/api). Запросы идут с сервера
# Next.js, а не из браузера — эта переменная не должна начинаться с
# NEXT_PUBLIC_, иначе попадёт в клиентский бандл.
API_BASE_URL=http://127.0.0.1:8000

# Публичный @username Telegram-бота для Login Widget на /login. Не секрет
# (виден всем в Telegram), поэтому NEXT_PUBLIC_ — доступен в браузере.
# Домен сайта должен быть привязан к боту через @BotFather (/setdomain),
# иначе виджет покажет "Bot domain invalid".
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=miradastu_bot

# Часовой пояс студии для отображения времени занятий. Должен совпадать со
# STUDIO_TIMEZONE backend'а (по умолчанию в обоих — Europe/Moscow).
STUDIO_TIMEZONE=Europe/Moscow
